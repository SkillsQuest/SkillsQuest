    "edges": [],
    "attrs": [{ "key": "str", "name": "力量", "type": "number" }],
    "awards": [
      { "id": "aw", "name": "力者", "need": 1, "gem": 5, "when": { "gte": [{ "get": "attr.str" }, 10] } }
    ],
    "requires": ["cond/expr", "attr/self"]
  },
  "expect": {
    "ok": false,
    "issues": [
      { "level": "error", "code": "AWARD_COND_WITH_GEM", "path": "/awards/0", "detail": { "id": "aw" } }
